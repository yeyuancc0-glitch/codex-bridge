SDKROOT = macosx
MACOSX_DEPLOYMENT_TARGET = 14.0
SUPPORTED_PLATFORMS = macosx
ARCHS = $(ARCHS_STANDARD)

PRODUCT_NAME = CodexBridge
PRODUCT_BUNDLE_IDENTIFIER = org.codexbridge.CodexBridge
MARKETING_VERSION = 0.2.1
CURRENT_PROJECT_VERSION = 4
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = Codex Bridge
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.developer-tools
INFOPLIST_KEY_LSUIElement = NO

SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_EMIT_LOC_STRINGS = YES
CLANG_ENABLE_MODULES = YES
ENABLE_USER_SCRIPT_SANDBOXING = NO

TUNNEL_HELPER_DIRECTORY =
TUNNEL_HELPER_UNSIGNED_SHA256 =
REQUIRE_TUNNEL_HELPER = NO

ENABLE_APP_SANDBOX = NO
ENABLE_HARDENED_RUNTIME = YES
CODE_SIGN_ENTITLEMENTS = App/CodexBridge.entitlements
CODE_SIGN_STYLE = Automatic

ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
