<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>CodexBridge.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType Condition="'$(BuildMsix)' != 'true'">None</WindowsPackageType>
    <WindowsPackageType Condition="'$(BuildMsix)' == 'true'">MSIX</WindowsPackageType>
    <EnableMsixTooling Condition="'$(BuildMsix)' == 'true'">true</EnableMsixTooling>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <GenerateAppxPackageOnBuild Condition="'$(BuildMsix)' == 'true'">true</GenerateAppxPackageOnBuild>
    <AppxBundle>Never</AppxBundle>
    <SelfContained Condition="'$(BuildMsix)' == 'true' Or '$(BuildSelfContained)' == 'true'">true</SelfContained>
    <WindowsAppSDKSelfContained Condition="'$(BuildMsix)' == 'true' Or '$(BuildSelfContained)' == 'true'">true</WindowsAppSDKSelfContained>
    <WindowsAppSdkBootstrapInitialize Condition="'$(BuildSelfContained)' == 'true'">false</WindowsAppSdkBootstrapInitialize>
    <WindowsAppSdkUndockedRegFreeWinRTInitialize Condition="'$(BuildSelfContained)' == 'true'">true</WindowsAppSdkUndockedRegFreeWinRTInitialize>
    <DefineConstants Condition="'$(BuildSelfContained)' == 'true'">$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Web.WebView2" />
    <PackageReference Include="System.Security.Permissions"
                      Condition="'$(BuildMsix)' == 'true'"
                      PrivateAssets="all" />
    <ProjectReference Include="..\BridgeIPC.Client\BridgeIPC.Client.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(BuildMsix)' == 'true'">
    <Content Include="..\..\App\Resources\Assets.xcassets\AppIcon.appiconset\AppIcon-512@2x.png"
             Link="Assets\AppIcon.png" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(BridgeServicePayload)')">
    <Content Include="$(BridgeServicePayload)\**\*"
             Exclude="$(BridgeServicePayload)\CodexBridge.App.exe">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
