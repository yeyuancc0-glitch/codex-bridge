<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>CodexBridge.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <SelfContained Condition="'$(BuildSelfContained)' == 'true'">true</SelfContained>
    <WindowsAppSDKSelfContained Condition="'$(BuildSelfContained)' == 'true'">true</WindowsAppSDKSelfContained>
    <WindowsAppSdkBootstrapInitialize Condition="'$(BuildSelfContained)' == 'true'">false</WindowsAppSdkBootstrapInitialize>
    <WindowsAppSdkUndockedRegFreeWinRTInitialize Condition="'$(BuildSelfContained)' == 'true'">false</WindowsAppSdkUndockedRegFreeWinRTInitialize>
    <WindowsAppSdkAutoInitialize Condition="'$(BuildSelfContained)' == 'true'">false</WindowsAppSdkAutoInitialize>
    <DefineConstants Condition="'$(BuildSelfContained)' == 'true'">$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Web.WebView2" />
    <ProjectReference Include="..\BridgeIPC.Client\BridgeIPC.Client.csproj" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(BridgeServicePayload)')">
    <Content Include="$(BridgeServicePayload)\**\*"
             Exclude="$(BridgeServicePayload)\CodexBridge.App.exe">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
