<Window
    x:Class="CodexBridge.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:CodexBridge.App.Views"
    Title="Codex Bridge">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <Ellipse x:Name="ConnectionIndicator" Width="10" Height="10" Fill="{ThemeResource SystemFillColorCautionBrush}" />
                    <TextBlock x:Name="ConnectionLabel" Text="正在连接 Service" Style="{ThemeResource BodyStrongTextBlockStyle}" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <TextBlock x:Name="PathSummary" Grid.Column="1" Text="Named Pipe → Bridge Core → Codex" FontFamily="Consolas" Opacity="0.72" />
                <Button x:Name="RefreshButton" Grid.Column="2" Content="刷新" Click="RefreshButtonClick" AutomationProperties.Name="刷新服务状态" />
            </Grid>
        </Border>

        <NavigationView x:Name="Navigation" Grid.Row="1" IsBackButtonVisible="Collapsed" IsSettingsVisible="True" PaneTitle="Codex Bridge" SelectionChanged="NavigationSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="概览" Tag="overview" Icon="Home" />
                <NavigationViewItem Content="任务" Tag="tasks" Icon="AllApps" />
                <NavigationViewItem Content="项目" Tag="projects" Icon="Folder" />
                <NavigationViewItem Content="审批" Tag="approvals" Icon="Important" />
                <NavigationViewItem Content="连接" Tag="connections" Icon="World" />
                <NavigationViewItem Content="工作台" Tag="workbench" Icon="Globe" />
            </NavigationView.MenuItems>
            <Grid>
                <ScrollViewer x:Name="Overview" Padding="32,24">
                    <StackPanel MaxWidth="920" HorizontalAlignment="Left" Spacing="24">
                        <StackPanel Spacing="4">
                            <TextBlock Text="本机运行状态" Style="{ThemeResource TitleTextBlockStyle}" />
                            <TextBlock Text="状态来自 Swift Service；Windows App 只负责呈现和本机决策。" Opacity="0.72" />
                        </StackPanel>
                        <Grid ColumnSpacing="32" RowSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="MCP" Style="{ThemeResource CaptionTextBlockStyle}" />
                                <TextBlock x:Name="McpState" Text="未知" Style="{ThemeResource SubtitleTextBlockStyle}" AutomationProperties.LiveSetting="Polite" />
                                <TextBlock x:Name="McpEndpoint" Text="—" FontFamily="Consolas" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="CODEX" Style="{ThemeResource CaptionTextBlockStyle}" />
                                <TextBlock x:Name="CodexState" Text="未知" Style="{ThemeResource SubtitleTextBlockStyle}" AutomationProperties.LiveSetting="Polite" />
                                <TextBlock x:Name="CodexVersion" Text="—" FontFamily="Consolas" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Text="SECURE TUNNEL" Style="{ThemeResource CaptionTextBlockStyle}" />
                                <TextBlock x:Name="TunnelState" Text="未知" Style="{ThemeResource SubtitleTextBlockStyle}" AutomationProperties.LiveSetting="Polite" />
                                <TextBlock x:Name="TunnelDetail" Text="—" FontFamily="Consolas" />
                            </StackPanel>
                        </Grid>
                        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="需要处理" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="ApprovalSummary" Text="等待 Service 状态" />
                                <ItemsControl x:Name="Degradations" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <Grid x:Name="TasksView" Visibility="Collapsed" Padding="32,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="任务" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,0,0,16" />
                    <ListView x:Name="TaskList" Grid.Row="1" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding TaskId}" FontFamily="Consolas" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding Status}" />
                                    <TextBlock Grid.Column="2" Text="{Binding CurrentStep}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{Binding UpdatedAt}" FontFamily="Consolas" Opacity="0.72" />
                                    <Button Grid.Column="4" Content="详情" DataContext="{Binding}" Click="TaskDetailsClick" AutomationProperties.Name="{Binding DetailsAutomationName}" />
                                    <Button Grid.Column="5" Content="停止" DataContext="{Binding}" Click="StopTaskClick" AutomationProperties.Name="{Binding StopAutomationName}" />
                                    <Button Grid.Column="6" Content="删除" DataContext="{Binding}" Click="DeleteTaskClick" AutomationProperties.Name="{Binding DeleteAutomationName}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
                <Grid x:Name="ProjectsView" Visibility="Collapsed" Padding="32,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,16" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="已注册项目" Style="{ThemeResource TitleTextBlockStyle}" />
                        <Button Grid.Column="1" Content="添加项目" Click="AddProjectClick" AutomationProperties.Name="选择文件夹并注册项目" />
                    </Grid>
                    <ListView x:Name="ProjectList" Grid.Row="1" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Grid.Column="1" Text="{Binding ProjectId}" FontFamily="Consolas" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding Capabilities.Summary}" />
                                    <Button Grid.Column="3" Content="权限" DataContext="{Binding}" Click="EditProjectPolicyClick" AutomationProperties.Name="{Binding PolicyAutomationName}" />
                                    <Button Grid.Column="4" Content="管理" DataContext="{Binding}" Click="ManageProjectClick" AutomationProperties.Name="{Binding ManageAutomationName}" />
                                    <Button Grid.Column="5" Content="移除" DataContext="{Binding}" Click="RemoveProjectClick" AutomationProperties.Name="{Binding RemoveAutomationName}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
                <ScrollViewer x:Name="ApprovalsView" Visibility="Collapsed" Padding="32,24">
                    <StackPanel Spacing="24">
                        <StackPanel Spacing="4">
                            <TextBlock Text="本机审批" Style="{ThemeResource TitleTextBlockStyle}" />
                            <TextBlock Text="批准只发送给本机 Service；App 不生成或持久化授权。" Opacity="0.72" />
                        </StackPanel>
                        <ListView x:Name="ApprovalList" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding Title}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding DisplayCommand}" FontFamily="Consolas" Opacity="0.72" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="拒绝" DataContext="{Binding}" Click="DenyCodexApprovalClick" AutomationProperties.Name="{Binding DenyAutomationName}" />
                                        <Button Grid.Column="2" Content="批准" DataContext="{Binding}" Click="ApproveCodexApprovalClick" AutomationProperties.Name="{Binding ApproveAutomationName}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock Text="Direct 审批" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <ListView x:Name="DirectApprovalList" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding Kind}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding ProjectId}" FontFamily="Consolas" Opacity="0.72" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="拒绝" DataContext="{Binding}" Click="DenyDirectApprovalClick" AutomationProperties.Name="{Binding DenyAutomationName}" />
                                        <Button Grid.Column="2" Content="批准" DataContext="{Binding}" Click="ApproveDirectApprovalClick" AutomationProperties.Name="{Binding ApproveAutomationName}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>
                <Grid x:Name="ConnectionsView" Visibility="Collapsed" Padding="32,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,16" Spacing="4">
                        <TextBlock Text="MCP Clients" Style="{ThemeResource TitleTextBlockStyle}" />
                        <TextBlock Text="客户端权限由 Swift Service 持有；完整模式仍受项目权限、workspace gate 与本机审批约束。" Opacity="0.72" />
                    </StackPanel>
                    <TextBlock x:Name="McpClientActionStatus" Grid.Row="1" Margin="0,0,0,12" Opacity="0.72" />
                    <ListView x:Name="McpClientList" Grid.Row="2" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="8" Spacing="10">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DisplayName}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Grid.Column="1" Text="{Binding ClientId}" FontFamily="Consolas" />
                                        <TextBlock Grid.Column="2" Text="{Binding State}" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="{Binding EnabledAction}" DataContext="{Binding}" IsEnabled="{Binding CanToggleEnabled}" Click="ToggleMcpClientEnabledClick" />
                                        <Button Content="{Binding ExposureAction}" DataContext="{Binding}" IsEnabled="{Binding CanChangeExposure}" Click="ToggleMcpClientExposureClick" />
                                        <Button Content="复制 Qwen JSON 配置" DataContext="{Binding}" IsEnabled="{Binding CanManageCredential}" Click="ExportMcpClientConfigurationClick" />
                                        <Button Content="重新生成凭证" DataContext="{Binding}" IsEnabled="{Binding CanManageCredential}" Click="RotateMcpClientCredentialClick" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
                <ScrollViewer x:Name="SettingsView" Visibility="Collapsed" Padding="32,24">
                    <StackPanel Spacing="20" MaxWidth="920" HorizontalAlignment="Left">
                        <TextBlock Text="设置" Style="{ThemeResource TitleTextBlockStyle}" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="后台 Service" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="StartupTaskStateLabel" Text="正在读取 StartupTask 状态" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="EnableStartupTaskButton" Content="登录后自动启动" Click="EnableStartupTaskClick" Visibility="Collapsed" />
                                <Button x:Name="DisableStartupTaskButton" Content="关闭自动启动" Click="DisableStartupTaskClick" Visibility="Collapsed" />
                            </StackPanel>
                        </StackPanel>
                        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="16">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Codex 默认模型" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="新任务未显式指定模型时使用；配置始终由后台 Service 持有。" Opacity="0.72" />
                                </StackPanel>
                                <Grid ColumnSpacing="16" RowSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="360" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="执行模型" VerticalAlignment="Center" />
                                    <ComboBox x:Name="ExecutionModelBox" Grid.Column="1" DisplayMemberPath="DisplayLabel" SelectionChanged="ExecutionModelSelectionChanged" AutomationProperties.Name="执行模型" />
                                    <TextBlock Grid.Row="1" Text="执行推理强度" VerticalAlignment="Center" />
                                    <ComboBox x:Name="ExecutionEffortBox" Grid.Row="1" Grid.Column="1" AutomationProperties.Name="执行推理强度" />
                                    <TextBlock Grid.Row="2" Text="访问模式" VerticalAlignment="Center" />
                                    <ComboBox x:Name="AccessModeBox" Grid.Row="2" Grid.Column="1" DisplayMemberPath="Label" AutomationProperties.Name="访问模式" />
                                    <TextBlock Grid.Row="3" Text="Fast 模式" VerticalAlignment="Center" />
                                    <ToggleSwitch x:Name="FastModeSwitch" Grid.Row="3" Grid.Column="1" OffContent="关闭" OnContent="启用" AutomationProperties.Name="Fast 模式" />
                                    <TextBlock Grid.Row="4" Text="Supervisor" VerticalAlignment="Center" />
                                    <ToggleSwitch x:Name="SupervisorEnabledSwitch" Grid.Row="4" Grid.Column="1" OffContent="关闭" OnContent="只读监督" AutomationProperties.Name="Supervisor" />
                                    <TextBlock Grid.Row="5" Text="Supervisor 模型" VerticalAlignment="Center" />
                                    <ComboBox x:Name="SupervisorModelBox" Grid.Row="5" Grid.Column="1" DisplayMemberPath="DisplayLabel" SelectionChanged="SupervisorModelSelectionChanged" AutomationProperties.Name="Supervisor 模型" />
                                    <TextBlock Grid.Row="6" Text="Supervisor 推理强度" VerticalAlignment="Center" />
                                    <ComboBox x:Name="SupervisorEffortBox" Grid.Row="6" Grid.Column="1" AutomationProperties.Name="Supervisor 推理强度" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button Content="保存模型偏好" Click="SaveModelPreferencesClick" />
                                    <TextBlock x:Name="ModelSettingsStatus" VerticalAlignment="Center" Opacity="0.72" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="16">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="OpenAI Secure MCP Tunnel" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="Runtime Key 只通过当前用户的 Named Pipe 发送给 Service，并由 Windows Secret Store 持有。" Opacity="0.72" />
                                </StackPanel>
                                <Grid ColumnSpacing="16" RowSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="420" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Tunnel ID" VerticalAlignment="Center" />
                                    <TextBox x:Name="TunnelIdBox" Grid.Column="1" PlaceholderText="tunnel_..." AutomationProperties.Name="Tunnel ID" />
                                    <TextBlock Grid.Row="1" Text="Runtime Key" VerticalAlignment="Center" />
                                    <PasswordBox x:Name="TunnelRuntimeKeyBox" Grid.Row="1" Grid.Column="1" PasswordChar="●" AutomationProperties.Name="Tunnel Runtime Key" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="ConfigureTunnelButton" Content="保存并连接" Click="ConfigureTunnelClick" />
                                    <Button x:Name="ConnectTunnelButton" Content="连接" Click="ConnectTunnelClick" />
                                    <Button x:Name="DisconnectTunnelButton" Content="断开" Click="DisconnectTunnelClick" />
                                    <Button x:Name="ClearTunnelButton" Content="清除配置" Click="ClearTunnelClick" />
                                </StackPanel>
                                <TextBlock x:Name="TunnelSettingsStatus" TextWrapping="Wrap" Opacity="0.72" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <views:WorkbenchHost x:Name="Workbench" Visibility="Collapsed" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
