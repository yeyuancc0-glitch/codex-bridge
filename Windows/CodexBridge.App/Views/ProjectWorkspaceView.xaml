<UserControl
    x:Class="CodexBridge.App.Views.ProjectWorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Width="900" Height="620">
        <TabView IsAddTabButtonVisible="False" CanReorderTabs="False">
            <TabViewItem Header="Direct 命令" IsClosable="False">
                <ScrollViewer Padding="4,12,12,4">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="执行策略" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <ComboBox x:Name="CommandModeBox" Width="300" HorizontalAlignment="Left" DisplayMemberPath="Label" AutomationProperties.Name="Direct 命令执行策略" />
                            <CheckBox x:Name="FullModeConfirmation" Content="我确认完全模式会跳过允许命令白名单" Visibility="Collapsed" />
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="允许命令" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <Button Grid.Column="1" Content="添加命令" Click="AddCommandClick" />
                        </Grid>
                        <ItemsControl x:Name="CommandList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,10">
                                        <Grid ColumnSpacing="10" RowSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBox Header="名称" Text="{Binding Name, Mode=TwoWay}" MaxLength="256" />
                                            <TextBox Grid.Column="1" Header="可执行文件" Text="{Binding Executable, Mode=TwoWay}" MaxLength="4096" FontFamily="Consolas" />
                                            <TextBox Grid.Column="2" Header="参数前缀（每行一个）" Text="{Binding ArgumentsText, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" />
                                            <Button Grid.Column="3" Content="移除" DataContext="{Binding}" Click="RemoveCommandClick" VerticalAlignment="Bottom" />
                                            <TextBox Grid.Row="1" Grid.ColumnSpan="2" Header="相对工作目录（可选）" Text="{Binding WorkingDirectory, Mode=TwoWay}" MaxLength="1024" FontFamily="Consolas" />
                                            <CheckBox Grid.Row="1" Grid.Column="2" Content="需要网络" IsChecked="{Binding RequiresNetwork, Mode=TwoWay}" VerticalAlignment="Bottom" />
                                            <ComboBox Grid.Row="2" Grid.ColumnSpan="2" Header="风险级别" SelectedValue="{Binding Risk, Mode=TwoWay}" SelectedValuePath="Tag">
                                                <ComboBoxItem Content="普通" Tag="normal" />
                                                <ComboBoxItem Content="高风险" Tag="elevated" />
                                            </ComboBox>
                                            <TextBox Grid.Row="2" Grid.Column="2" Header="命令 ID" Text="{Binding CommandId, Mode=TwoWay}" MaxLength="128" FontFamily="Consolas" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="黑名单（所有模式均生效）" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <Button Grid.Column="1" Content="添加规则" Click="AddBlacklistClick" />
                        </Grid>
                        <ItemsControl x:Name="BlacklistList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="10" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Header="规则 ID" Text="{Binding RuleId, Mode=TwoWay}" MaxLength="128" FontFamily="Consolas" />
                                        <TextBox Grid.Column="1" Header="可执行文件（可选）" Text="{Binding Executable, Mode=TwoWay}" MaxLength="4096" FontFamily="Consolas" />
                                        <TextBox Grid.Column="2" Header="参数包含（可选）" Text="{Binding Pattern, Mode=TwoWay}" MaxLength="4096" FontFamily="Consolas" />
                                        <Button Grid.Column="3" Content="移除" DataContext="{Binding}" Click="RemoveBlacklistClick" VerticalAlignment="Bottom" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="保存 Direct 配置" Click="SaveDirectClick" Style="{ThemeResource AccentButtonStyle}" />
                            <TextBlock x:Name="DirectStatus" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="Threads" IsClosable="False">
                <Grid Padding="4,12,4,4" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="310" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Button Content="刷新 Threads" Click="RefreshThreadsClick" HorizontalAlignment="Left" Margin="0,0,0,10" />
                    <ListView x:Name="ThreadList" Grid.Row="1" SelectionChanged="ThreadSelectionChanged" AutomationProperties.Name="项目 Threads">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="8" Spacing="3">
                                    <TextBlock Text="{Binding DisplayTitle}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" Opacity="0.72" />
                                    <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" MaxLines="3" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Column="1" Grid.RowSpan="2" Spacing="8">
                        <TextBlock x:Name="ThreadTitle" Text="选择一个 Thread" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <ListView x:Name="ThreadEntryList" AutomationProperties.Name="Thread 对话内容">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="8" Spacing="3">
                                        <TextBlock Text="{Binding Heading}" Opacity="0.72" />
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Skills" IsClosable="False">
                <Grid Padding="4,12,4,4" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Button Content="刷新 Skills" Click="RefreshSkillsClick" HorizontalAlignment="Left" Margin="0,0,0,10" />
                    <ListView x:Name="SkillList" Grid.Row="1" SelectionChanged="SkillSelectionChanged" AutomationProperties.Name="项目与全局 Skills">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,10">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding Name}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{Binding Metadata}" Opacity="0.72" />
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding TriggerSummary}" FontFamily="Consolas" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Grid Grid.Column="1" Grid.RowSpan="2" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="SkillDocumentTitle" Text="选择一个 Skill 预览" Style="{ThemeResource BodyStrongTextBlockStyle}" AutomationProperties.LiveSetting="Polite" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="SkillDocumentContent" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontFamily="Consolas" AutomationProperties.Name="Skill 文档预览" />
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabViewItem>
        </TabView>
    </Grid>
</UserControl>
