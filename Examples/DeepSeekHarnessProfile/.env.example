# Copy this file to .env beside the cordis.yml registered in Codex Bridge.
# Fill credentials locally. Never commit or share the resulting .env file.
DEEPSEEK_API_KEY=

# Main DeepSeek-compatible chat-completions endpoint.
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Independent Anthropic-compatible Web Search base. DSH appends /messages.
# The endpoint must support the native web_search_20250305 server tool.
DEEPSEEK_SEARCH_BASE_URL=https://api.deepseek.com/anthropic/v1
